# Copy to `.env` and fill in. `.env` is gitignored -- never commit a real key.
#
# Credentials are env-only by design in this app: they are read straight from
# the process environment at client-build time and are deliberately NOT
# accepted by `POST /api/config` nor stored in `<vault>/.mythic.toml`.
# scripts/dev.ps1 and scripts/prod.ps1 load this file at launch; a variable
# already exported in your shell always wins over the value here.
#
# Changing a value here requires restarting the server to take effect.

# --- LLM credential (pick the one matching your provider) ------------------

# AuthHub gateway (the default provider) -- an OpenAI-compatible multi-provider
# proxy. Required for `ingest --compile`, `query`, and `index-graph`.
AUTHHUB_API_KEY=

# Direct-to-Anthropic instead: set MYTHIC_LLM_PROVIDER=anthropic below and
# supply this key rather than the AuthHub one.
# ANTHROPIC_API_KEY=

# --- Optional overrides ----------------------------------------------------

# Where the AuthHub gateway listens (default: http://localhost:3000).
# AUTHHUB_BASE_URL=http://localhost:3000

# Provider: authhub (default) | anthropic | ollama
# MYTHIC_LLM_PROVIDER=authhub

# Model slug sent to the active provider (default: deepseek-chat).
# MYTHIC_LLM_MODEL=deepseek-chat

# Fully-local mode: forces Ollama and never touches a cloud endpoint,
# regardless of the provider above. No API key needed.
# MYTHIC_LOCAL=true
